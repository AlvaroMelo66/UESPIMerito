{
  "name": "uespimerito",
  "version": "1.0.0",
  "private": true,
  "description": "UESPIMerito (UESPM) - token ERC-20 para recompensas academicas",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:coverage": "hardhat coverage && hardhat compile --force",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "deploy:sepolia": "hardhat run scripts/deploy.js --network sepolia",
    "verify:sepolia": "hardhat run scripts/verify.js --network sepolia",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "frontend:preview": "npm --prefix frontend run preview",
    "abi:export": "node scripts/export-abi.js"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.0",
    "@nomicfoundation/hardhat-ethers": "^3.1.0",
    "@nomicfoundation/hardhat-verify": "^2.1.1",
    "@openzeppelin/contracts": "^5.4.0",
    "chai": "^4.5.0",
    "dotenv": "^17.2.0",
    "ethers": "^6.15.0",
    "hardhat": "^2.26.0",
    "solidity-coverage": "^0.8.16"
  }
}
